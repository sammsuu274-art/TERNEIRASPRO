# ==============================================================================
# ARQUIVO DE CONFIGURAÇÃO - TERNEIRASPRO EM PRODUÇÃO
# 
# INSTRUÇÕES:
# 1. Copiar este arquivo para .env na raiz do projeto
# 2. Preencher todos os valores marcados com [COMPLETAR]
# 3. NUNCA fazer commit deste arquivo no repositório
# 4. NUNCA compartilhar SECRET_KEY ou credenciais
# ==============================================================================

# SEGURANÇA - Django
# Gerar com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=[COMPLETAR_COM_CHAVE_CRIPTOGRAFICA_FORTE]

# Modo de debug (SEMPRE False em produção)
DEBUG=False

# Hosts permitidos (adicionar domínio do PythonAnywhere)
# Exemplo: victor-terneiras.pythonanywhere.com,localhost,127.0.0.1
ALLOWED_HOSTS=[COMPLETAR_COM_DOMINIO_PYTHONANYWHERE],localhost,127.0.0.1

# BANCO DE DADOS
# Em PythonAnywhere, usar SQLite (arquivo local)
# Caminho completo: /home/seu_username/TerneirasPro/db.sqlite3
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=/home/[COMPLETAR_COM_USERNAME]/TerneirasPro/db.sqlite3

# TIMEZONE (importante para cálculos de data/hora)
TIME_ZONE=America/Sao_Paulo

# CSRF - Proteção contra falsificação de requisições
CSRF_TRUSTED_ORIGINS=https://[COMPLETAR_COM_DOMINIO_PYTHONANYWHERE]

# ==============================================================================
# NOTAS SOBRE VALORES
# ==============================================================================

# [COMPLETAR_COM_DOMINIO_PYTHONANYWHERE]
# Exemplo: victor-terneiras.pythonanywhere.com
# (fornecido automaticamente pelo PythonAnywhere)
#
# [COMPLETAR_COM_USERNAME]
# Exemplo: victor_terneiras
# (seu username no PythonAnywhere)
#
# [COMPLETAR_COM_CHAVE_CRIPTOGRAFICA_FORTE]
# Gerar localmente:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
